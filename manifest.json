{
  "manifest_version": 3,
  "name": "Tabar - Vertical Tab Manager",
  "version": "0.3.0",
  "description": "Manage tabs in sidebar with drag & drop, tab groups, and session saving",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Tabar"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Open sidebar"
    }
  }
}
